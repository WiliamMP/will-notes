{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "will-notes",
  "version": "0.3.0",
  "identifier": "com.wiliammp.will-notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "will-notes",
        "width": 1000,
        "height": 680,
        "minWidth": 600,
        "minHeight": 400,
        "visible": false,
        "decorations": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 360,
        "height": 300,
        "decorations": false,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyRjdCRDVFMjM2RkI4QTAKUldTZ3VHOGpYcjMzTWh3UVRjeGNUU1JIOEI2RERaL0JVQ2VQdVJSaXdaamJpUlBPbDkvZjNTYlMK",
      "endpoints": [
        "https://github.com/WiliamMP/will-notes/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
